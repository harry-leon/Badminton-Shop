# ==============================================================================
# FRONTEND PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend REST API Endpoint (Render / Railway / Cloud)
NEXT_PUBLIC_API_URL=https://badminton-api.onrender.com/api/v1

# ImageKit CDN Configuration
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Database Direct Fallback (Supabase PostgreSQL with SSL)
PG_HOST=db.your-project.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your_supabase_password

# Next.js Session Secret
SESSION_SECRET=your_session_secret_key_at_least_32_characters

# Cron & Scheduled Jobs Secret
CRON_SECRET=your_cron_secret_token
