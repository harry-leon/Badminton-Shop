# ==============================================================================
# ENTERPRISE MONOLITH ENVIRONMENT VARIABLES & SECRETS TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Spring Boot 3 on Render / Railway / Docker)
# ------------------------------------------------------------------------------
# Database: Supabase PostgreSQL (SSL required)
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<SUPABASE_PASSWORD>

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true

# Redis Cache & Rate Limiting (Upstash / Redis Cloud)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false
MANAGEMENT_HEALTH_REDIS_ENABLED=false

# Security & JWT
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long

# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Java Runtime Options (Optimized for Render Free 512MB RAM)
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (Next.js on Cloudflare Pages / Workers / Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://badminton-api.onrender.com/api/v1
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
SESSION_SECRET=your_session_secret_key_at_least_32_characters
CRON_SECRET=your_cron_secret_token
